{
  "name": "@serenity/core",
  "version": "0.1.0",
  "description": "Core business logic and utilities for Serenity Notes",
  "main": "dist-cjs/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist-cjs/index.js"
    }
  },
  "scripts": {
    "build": "npm run clean && tsc",
    "dev": "tsc --watch",
    "lint": "eslint src/**/*.ts",
    "test": "jest",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^1.9.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/pg": "^8.15.5",
    "bcryptjs": "^3.0.2",
    "date-fns": "^2.30.0",
    "pg": "^8.16.3",
    "uuid": "^9.0.0",
    "zod": "^3.22.2"
  },
  "devDependencies": {
    "@types/uuid": "^9.0.2",
    "eslint": "^8.48.0",
    "jest": "^29.6.3",
    "typescript": "^5.2.2"
  }
}
