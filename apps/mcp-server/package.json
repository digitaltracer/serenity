{
  "name": "@serenity/mcp-server",
  "version": "1.0.0",
  "description": "MCP server for Serenity Notes - manage tasks and journal entries via AI assistants",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "clean": "rm -rf dist",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "jest"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "serenity",
    "productivity",
    "tasks",
    "journal"
  ],
  "author": "Serenity Team",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "@serenity/core": "*",
    "@serenity/database": "*",
    "express": "^4.18.2",
    "zod": "^3.22.4",
    "bcryptjs": "^2.4.3",
    "express-rate-limit": "^7.1.5",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "winston": "^3.11.0",
    "axios": "^1.6.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.5",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.11"
  }
}
