{
  "name": "serenity-notes",
  "version": "0.1.0",
  "private": true,
  "description": "Cross-platform productivity application with ActionHub and Journal",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "test": "turbo test",
    "clean": "turbo clean",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@turbo/gen": "^1.10.7",
    "@typescript-eslint/eslint-plugin": "^6.7.0",
    "@typescript-eslint/parser": "^6.7.0",
    "electron-builder": "^26.0.12",
    "eslint": "^8.48.0",
    "eslint-config-prettier": "^9.0.0",
    "prettier": "^3.0.3",
    "turbo": "^1.10.7",
    "typescript": "^5.2.2"
  },
  "packageManager": "npm@9.8.1",
  "workspaces": [
    "apps/desktop",
    "packages/*"
  ]
