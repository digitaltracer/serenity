{
  "name": "serenity-notes",
  "version": "0.1.0",
  "private": true,
  "description": "Cross-platform productivity application with ActionHub and Journal",
  "scripts": {
    "build": "npm -w @serenity/core run build && npm -w @serenity/database run build && npm -w @serenity/ui run build && npm -w @serenity/desktop run build",
    "dev": "turbo run dev --no-daemon",
    "lint": "turbo run lint --no-daemon",
    "test": "turbo run test --no-daemon",
    "clean": "turbo run clean --no-daemon",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "type-check": "tsc --noEmit",
    "docs:generate": "typedoc",
    "prepare:logos": "bash scripts/prepare-logos.sh",
    "postinstall": "npm run build"
  },
  "devDependencies": {
    "@turbo/gen": "^1.10.7",
    "@typescript-eslint/eslint-plugin": "^6.7.0",
    "@typescript-eslint/parser": "^6.7.0",
    "electron-builder": "^26.0.12",
    "eslint": "^8.48.0",
    "eslint-config-prettier": "^9.0.0",
    "prettier": "^3.0.3",
    "turbo": "^1.10.7",
    "typedoc": "^0.28.14",
    "typedoc-plugin-markdown": "^4.9.0",
    "typescript": "^5.2.2"
  },
  "packageManager": "npm@9.8.1",
  "workspaces": [
    "apps/desktop",
    "packages/*"
  ]
}
