# ============================================================================
# Serenity Web App - Environment Variables
# ============================================================================
# Copy this file to .env.local and fill in your values

# ----------------------------------------------------------------------------
# Database Configuration
# ----------------------------------------------------------------------------
# PostgreSQL connection string
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/serenity_dev

# Enable SSL for database connection (set to true for production)
DATABASE_SSL=false

# ----------------------------------------------------------------------------
# NextAuth Configuration
# ----------------------------------------------------------------------------
# The URL where your app is hosted (change in production)
NEXTAUTH_URL=http://localhost:3000

# Secret for signing JWT tokens
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-secret-key-here-change-in-production

# Trusted hosts for NextAuth (comma-separated list)
# Example: serenitynotes.cloud,app.example.com
# Leave empty to trust all hosts (handled by trustHost: true in config)
AUTH_TRUST_HOST=

# ----------------------------------------------------------------------------
# OAuth Providers
# ----------------------------------------------------------------------------
# Google OAuth
# Get credentials from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# GitHub OAuth
# Get credentials from: https://github.com/settings/developers
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Microsoft OAuth
# Get credentials from: https://portal.azure.com/#blade/Microsoft_AAD_RegisteredApps
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret

# ----------------------------------------------------------------------------
# Encryption
# ----------------------------------------------------------------------------
# Server-side encryption key for OAuth tokens and integration credentials
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=your-256-bit-encryption-key-here

# ----------------------------------------------------------------------------
# Application Configuration
# ----------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=debug

# Public URL of the web app (used for OAuth device flow)
# This should be the publicly accessible URL (change in production)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ----------------------------------------------------------------------------
# AI Providers (Optional)
# ----------------------------------------------------------------------------
# Users can provide their own keys in the app, these are optional fallbacks
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=

# ----------------------------------------------------------------------------
# Sync Configuration
# ----------------------------------------------------------------------------
# Secret for desktop sync webhooks
# Generate with: openssl rand -base64 32
SYNC_WEBHOOK_SECRET=your-webhook-secret-for-desktop-notifications
